# Shared zshrc — sourced by machine-specific .zshrc

export PATH=$HOME/.bun/bin:$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
source $ZSH/oh-my-zsh.sh

# Starship prompt
eval "$(starship init zsh)"

# Aliases
alias zshrc="nvim ~/.zshrc"
alias zshcommon="nvim ~/.zshrc-common"
alias nviminit="nvim ~/.config/nvim/init.lua"
alias neoviminit="nvim ~/.config/nvim/init.lua"
alias ghosttyconfig="nvim ~/.config/ghostty/config"
alias ghosttykeybinds="ghostty +list-keybinds --default"
alias sites="cd ~/Sites"
alias dotfiles="cd ~/dotfiles"
alias sshconfig="nvim ~/.ssh/config"
alias dockerstart="sudo systemctl start docker docker.socket && echo 'Docker started.' && sudo docker info --format '{{printf \"Server Version: %s\nContainers: %d (%d running)\nImages: %d\" .ServerVersion .Containers .ContainersRunning .Images}}'"
alias dockerstop="sudo systemctl stop docker docker.socket && echo 'Docker stopped.' && echo 'Socket deactivated.'"
alias docker-restart="docker-compose down && docker-compose up -d"

# System updates
update() {
  command -v yay     >/dev/null && yay -Syu
  command -v flatpak >/dev/null && flatpak update

  # Keep the flatpak NVIDIA GL driver in sync with the loaded kernel module.
  # `flatpak update` will NOT do this: the matching GL.nvidia-X-Y-Z is a *new*
  # ref each driver bump, not an update of the installed one, so it must be
  # installed explicitly — otherwise nvidia flatpak apps (e.g. Plex) segfault.
  if command -v flatpak >/dev/null && [ -r /sys/module/nvidia/version ]; then
    local loaded installed
    loaded=$(< /sys/module/nvidia/version)
    echo "Syncing flatpak NVIDIA GL driver to ${loaded}..."
    flatpak install -y --noninteractive flathub \
      "org.freedesktop.Platform.GL.nvidia-${loaded//./-}" 2>/dev/null
    flatpak uninstall -y --unused --noninteractive 2>/dev/null
    # Warn if a newer driver is on disk but not yet loaded (reboot pending).
    installed=$(pacman -Q nvidia-utils 2>/dev/null | awk '{print $2}' | cut -d- -f1)
    if [ -n "$installed" ] && [ "$installed" != "$loaded" ]; then
      echo "nvidia-utils ${installed} is installed but ${loaded} is loaded —"
      echo "reboot, then run 'update' again so flatpak grabs the matching GL driver."
    fi
  fi
}
alias upgrade=update

# yt-dlp grabber: video by default, FLAC audio with -a, ./cookies.txt with -c
#   yoink URL           best video (bv*+ba) merged to mkv
#   yoink -c URL        ...with cookies.txt (for 1080p Premium etc.)
#   yoink -a URL        best-quality FLAC audio
#   yoink -ac URL       FLAC audio + cookies
# Flags must precede the URL(s); extra yt-dlp flags after the URL pass through.
yoink() {
  local audio=0 cookie=0 OPTIND
  while getopts "ach" opt; do
    case $opt in
      a) audio=1 ;;
      c) cookie=1 ;;
      h)
        cat >&2 <<'EOF'
usage: yoink [-a] [-c] [-h] URL...
  -a   audio only, best-quality FLAC (default: video)
  -c   use ./cookies.txt from the current dir (for Premium/logged-in content)
  -h   show this help
Combine flags (-ac), pass multiple URLs, and append extra yt-dlp flags after the URL.
EOF
        return 0 ;;
      *) echo "usage: yoink [-a] [-c] [-h] URL..." >&2; return 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  if (( $# == 0 )); then
    echo "usage: yoink [-a] [-c] [-h] URL..." >&2
    return 1
  fi

  local -a args
  (( cookie )) && args+=(--cookies cookies.txt)
  if (( audio )); then
    args+=(-f bestaudio -x --audio-format flac --audio-quality 0 --embed-metadata --embed-thumbnail)
  else
    args+=(-f "bv*+ba/b" --merge-output-format mkv)
  fi

  yt-dlp "${args[@]}" "$@"
}

