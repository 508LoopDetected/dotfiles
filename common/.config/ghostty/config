# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-size = 12
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

font-size = 14
#font-family = SpaceMono Nerd Font
#font-family = DMMono Nerd Font
font-family = GeistMono Nerd Font
# window-padding-x = 2

theme=Flexoki Dark
background-opacity=0.8
background-blur=true
#window-decoration=none

# close the focused split
keybind = ctrl+shift+x=close_surface

# reset all splits in the tab to equal sizes
keybind = ctrl+shift+equal=equalize_splits

# split in the direction with more room
keybind = ctrl+shift+s=new_split:auto

# Auto-export TERM=xterm-256color over SSH and install Ghostty's terminfo on
# remote hosts the first time we connect — fixes backspace/keys on hosts whose
# terminfo db doesn't know `xterm-ghostty` (Synology, older Debian/RHEL).
shell-integration-features = ssh-env,ssh-terminfo
